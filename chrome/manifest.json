{
  "manifest_version": 3,
  "name": "Agent Leaderboard",
  "version": "1.7.0",
  "description": "在侧边栏搜索 Agent Skills、MCP、Prompt、AI 框架和研究工具，使用 GitHub 账号同步网站与插件收藏。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://agentskills.media/*",
    "https://agent-leaderboard-api.jaychempan.workers.dev/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "打开 Agent 搜索助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "omnibox": {
    "keyword": "agent"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 Agent 搜索助手"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://agentskills.media https://agent-leaderboard-api.jaychempan.workers.dev; base-uri 'none'"
  },
  "key": ""
}
